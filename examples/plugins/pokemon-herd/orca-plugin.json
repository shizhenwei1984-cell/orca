{
  "manifestVersion": 2,
  "id": "pokemon-herd",
  "name": "Pokémon Herd",
  "version": "0.2.0",
  "description": "Raise a herd of Pokémon as your terminal agents work.",
  "engines": {
    "orca": ">=1.4.260"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "worker.mjs",
  "contributes": {
    "events": [{ "on": "agent.status.changed" }],
    "panels": [
      {
        "id": "pokemon-herd",
        "title": "Pokémon Herd",
        "icon": "activity",
        "entry": "panel/index.html",
        "defaultPlacement": "bottom"
      },
      {
        "id": "pokemon-sidebar",
        "title": "Pokémon Sidebar",
        "icon": "layers",
        "entry": "sidebar/index.html"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "workspace:read"
    },
    {
      "kind": "workspace:write"
    },
    {
      "kind": "workspace:create"
    },
    {
      "kind": "terminal:send"
    },
    {
      "kind": "agent:read"
    },
    {
      "kind": "storage:own"
    }
  ]
}
